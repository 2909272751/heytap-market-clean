<?xml version="1.0" encoding="utf-8"?>
<!--
  占位符说明：
    io.github.heytapmarketclean = 模块包名（如 io.github.xxxclean）
    软件商店净化             = 设置页显示名

  版本号**不要**在这里手写。build.ps1 在 aapt2 link 之前会把下面两个占位符
  替换成 $VERSION / $VERSION_CODE；占位符不存在时构建直接失败。

  为什么要这样：版本号曾经是「文件名 / module.prop / 本清单」三处手工维护的值，
  早就漂移过一次 —— 发了 v0.6.0，模块列表显示 0.6.0（读 module.prop），
  系统「应用信息」却还是 0.2.0（读本清单）。现在只有 build.ps1 的 $VERSION
  是唯一事实源，改版本只需要改那一行。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.heytapmarketclean"
    android:versionCode="@VERSION_CODE@"
    android:versionName="@VERSION@">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- LSPosed 框架服务通道（设置页与框架通信）；authorities 固定为 <模块包名>.XposedService -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="io.github.heytapmarketclean.XposedService"
            android:exported="true" />

        <!-- 目标进程 → 设置页的状态查询通道（只读） -->
        <provider
            android:name=".StatusProvider"
            android:authorities="io.github.heytapmarketclean.status"
            android:exported="true" />

        <!-- 目标进程 → 设置页的一次性状态广播 -->
        <receiver android:name=".StatusReceiver" android:exported="true">
            <intent-filter><action android:name="io.github.heytapmarketclean.REPORT" /></intent-filter>
        </receiver>
    </application>
</manifest>
