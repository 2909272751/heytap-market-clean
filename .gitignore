# =============================================================
#  目标 App（OPPO / 欢太 软件商店）的专有内容 —— 绝不入库
#  这些是逆向分析过程的输入与产物，属于 OPPO 的版权物。
#  本项目只发布「自己写的」代码与结论。
#  注意：.gitignore 不支持行尾注释，注释必须独占一行。
# =============================================================

# 目标 APK 本体
orig/

# 从目标 APK 提取的 dex
work/

# jadx 反编译产物
jadx-all/
jadx-mine/
jadx-out/
jadx-res/
tmp_dex/
tmp_res/

# 取证过程日志 / dump
recon/

# =============================================================
#  第三方项目与二进制工具
# =============================================================

# clone 下来的他人仓库（qq-music-lsposed / video-lsposed）
ref/

# 逆向分析用的第三方工具与一次性排查脚本。
# 这是本地工作区，不是交付物；其中可复用的 dex 分析脚本后续可单独整理发布。
tools/
__pycache__/

# jadx、Vector 框架等第三方压缩包
*.zip

# 任何 APK 都不入库；模块本体走 Release 附件分发
*.apk

# =============================================================
#  构建产物（走 Release 附件分发）
# =============================================================
app/dist/

# 签名密钥不入库；build.ps1 会在缺失时用 keytool 自动生成一把本地测试密钥。
# 注意：重新生成的密钥与已发布 APK 的签名不同，升级前需先卸载旧版。
app/debug.keystore

# =============================================================
#  临时 / 草稿
# =============================================================
tmp_*
*.log
*.csv

# docs 下的中间产物，只保留 *.md 与 shots/
docs/_*

# =============================================================
#  编辑器 / 系统
# =============================================================
.idea/
*.iml
.vscode/
Thumbs.db
desktop.ini
